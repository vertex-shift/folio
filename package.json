{
  "name": "folio-desktop",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "node scripts/prepare-assets.mjs",
    "predev": "npm run prepare",
    "dev": "vite --host 127.0.0.1 --strictPort",
    "prebuild": "npm run prepare",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.ts",
    "test:ocr": "node tests/ocr.e2e.mjs",
    "test:comparison": "node tests/comparison.e2e.mjs",
    "test:archive": "node tests/preflightArchive.e2e.mjs",
    "test:forms": "node tests/formsDesigner.e2e.mjs",
    "test:signatures": "node tests/signatures.e2e.mjs",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "bundle": "tauri build --bundles app",
    "preview:backend": "cargo run --manifest-path src-tauri/Cargo.toml --no-default-features --features preview --bin folio-preview",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "test:conversion": "node tests/conversion.e2e.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "diff": "^8.0.2",
    "lucide-react": "^1.54.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.1.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pdf-lib": "^1.17.1",
    "playwright": "1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}

  "narrative": {
    "northStar": "Document-first workspace",
    "overview": "Folio uses familiar desktop PDF-editor conventions with its own identity. The paper is the work surface, not a decorative preview inside a dashboard. Tools, document navigation, and review controls stay in predictable places.\n\nThe default light palette suits reviewing local documents at a normally lit desk; Dark, Sepia, and High Contrast extend the same workspace to other conditions. Actions, selection, and keyboard focus keep their semantic roles as the palette changes. The document well separates paper from the application.",
    "keyCharacteristics": [
      "Familiar PDF-editor organization with independently authored branding.",
      "Compact system typography and consistent outline icons.",
      "Clear selected, disabled, loading, error, and unsaved states.",
      "Real document content rather than simulated page artwork."
    ],
    "rules": [
      {
        "name": "The Document Boundary Rule",
        "body": "App selection colors and UI tokens must not recolor the user's PDF. Document fonts, artwork, and existing annotations belong to the document. Continuous reading uses 24px gaps, viewport-bounded renderers, synchronized page navigation, and stable zoom/resize anchors.",
        "section": "colors"
      },
      {
        "name": "Pending redaction boundary",
        "body": "Pending areas use fixed document-red #a32134 outlines, #a3213422 washes, and white numbered labels. These are review UI; only exported fresh image-only PDFs contain permanent black pixels. Preserve the original, protect pending marks, and disclose whole-document rasterization. Scroll review content above a fixed export footer; compact panels provide Mark on page and no tip obscures the PDF.",
        "section": "components"
      }
    ],
    "dos": [
      "Do keep the document as the primary work surface.",
      "Do use semantic action, selection, and focus colors consistently in every palette.",
      "Do preserve accessible names when compact layouts hide visible labels.",
      "Do show actual document state and actionable failures.",
      "Do keep app chrome independent of the PDF's fonts and artwork."
    ],
    "donts": [
      "Don't use Adobe branding or assets extracted from Acrobat.",
      "Don't present unsupported Acrobat features as working controls.",
      "Don't replace PDF rendering with a static document mockup.",
      "Don't hide a panel in CSS while leaving its toggle unable to reveal it.",
      "Don't imply cloud upload, autosave, notarization, or complete Acrobat parity."
    ]
  }
